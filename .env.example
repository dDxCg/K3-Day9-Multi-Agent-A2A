# Copy sang .env rồi điền key. KHÔNG commit .env.
# Tên model KHÔNG đặt ở đây — model name khai báo trong src/config.py để chấm điểm.

# groq | openrouter
LLM_PROVIDER=groq

GROQ_API_KEY=
OPENROUTER_API_KEY=

