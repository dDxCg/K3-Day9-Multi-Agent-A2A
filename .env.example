# LLM configuration — copy to .env and fill secrets locally.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash-lite
LLM_MODEL_PARAMETERS_B=unknown
LLM_MODEL_EFFECTIVE_PARAMETERS_B=unknown
LLM_MAX_PARAMETERS_B=10
LLM_RUNTIME=google_api
LLM_FRAMEWORK=Google Generative Language API

GOOGLE_API_KEY=

LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_REQUEST_DELAY_SECONDS=4
